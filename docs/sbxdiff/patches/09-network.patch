diff --git a/base/sbxdiff_net_store.cc b/base/sbxdiff_net_store.cc
new file mode 100644
index 0000000000000..977a177603044
--- /dev/null
+++ b/base/sbxdiff_net_store.cc
@@ -0,0 +1,122 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/sbxdiff_net_store.h"
+
+
+#include <optional>
+
+#include "base/base_switches.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/hash/hash.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace base::sbxdiff {
+
+namespace {
+
+const FilePath& RecordDir() {
+  static NoDestructor<FilePath> dir([] {
+    const CommandLine* cmd = CommandLine::ForCurrentProcess();
+    return cmd ? cmd->GetSwitchValuePath(::switches::kSbxdiffNetRecord)
+               : FilePath();
+  }());
+  return *dir;
+}
+
+const FilePath& ReplayDir() {
+  static NoDestructor<FilePath> dir([] {
+    const CommandLine* cmd = CommandLine::ForCurrentProcess();
+    return cmd ? cmd->GetSwitchValuePath(::switches::kSbxdiffNetReplay)
+               : FilePath();
+  }());
+  return *dir;
+}
+
+// 64 bits of filename, from two independent hashes. The URL is stored in the
+// file and verified on read, so a collision degrades to a recorded miss rather
+// than serving the wrong body.
+std::string KeyFor(const std::string& url) {
+  const uint32_t a = PersistentHash(url);
+  std::string reversed(url.rbegin(), url.rend());
+  const uint32_t b = PersistentHash(reversed);
+  return NumberToString(a) + "_" + NumberToString(b);
+}
+
+// url \n mime \n encoding \n body
+constexpr char kSep = '\n';
+
+}  // namespace
+
+bool IsRecordingResponses() {
+  return !RecordDir().empty();
+}
+
+bool IsReplayingResponses() {
+  return !ReplayDir().empty();
+}
+
+void RecordResponse(const std::string& url,
+                    const std::string& mime_type,
+                    const std::string& encoding,
+                    const char* data,
+                    size_t size) {
+  if (RecordDir().empty()) {
+    return;
+  }
+  const std::string& url_utf8 = url;
+  if (url_utf8.empty()) {
+    return;
+  }
+  std::string out;
+  out.reserve(url_utf8.size() + size + 64);
+  out.append(url_utf8).push_back(kSep);
+  out.append(mime_type).push_back(kSep);
+  out.append(encoding).push_back(kSep);
+  if (data && size) {
+    out.append(data, size);
+  }
+  // Best effort: a failed write shows up as a replay miss later, which is a
+  // recorded divergence rather than a silent wrong answer.
+  std::ignore = WriteFile(RecordDir().AppendASCII(KeyFor(url_utf8)), out);
+}
+
+bool LookupResponse(const std::string& url, StoredResponse* out) {
+  if (ReplayDir().empty()) {
+    return false;
+  }
+  const std::string& url_utf8 = url;
+  std::string contents;
+  if (!ReadFileToString(ReplayDir().AppendASCII(KeyFor(url_utf8)),
+                             &contents)) {
+    return false;
+  }
+  const size_t u = contents.find(kSep);
+  if (u == std::string::npos) {
+    return false;
+  }
+  // Collision guard: the stored URL must be the one asked for.
+  if (contents.compare(0, u, url_utf8) != 0) {
+    return false;
+  }
+  const size_t m = contents.find(kSep, u + 1);
+  if (m == std::string::npos) {
+    return false;
+  }
+  const size_t e = contents.find(kSep, m + 1);
+  if (e == std::string::npos) {
+    return false;
+  }
+  out->mime_type = contents.substr(u + 1, m - u - 1);
+  out->encoding = contents.substr(m + 1, e - m - 1);
+  out->body = contents.substr(e + 1);
+  return true;
+}
+
+}  // namespace base::sbxdiff
+
diff --git a/base/sbxdiff_net_store.h b/base/sbxdiff_net_store.h
new file mode 100644
index 0000000000000..e2ad7be0f2798
--- /dev/null
+++ b/base/sbxdiff_net_store.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_SBXDIFF_NET_STORE_H_
+#define BASE_SBXDIFF_NET_STORE_H_
+
+#include <string>
+
+#include "base/base_export.h"
+
+namespace base::sbxdiff {
+
+// sbxdiff: on-disk response-body store for hermetic network replay.
+//
+// Lives in //base because both ends need it and they are in different
+// processes: the recorder runs in the renderer (Blink probes see every
+// response body, including fetch()/XHR which are never buffered on the
+// Resource, and the main document which never goes through ResourceFetcher),
+// while replay runs in the browser (a URLLoaderFactory interceptor, the only
+// layer that also covers navigation).
+//
+// A file holds: url \n mime \n encoding \n body. The URL is verified on read,
+// so a filename-hash collision degrades to a recorded replay miss -- a
+// divergence -- rather than silently serving the wrong body.
+struct BASE_EXPORT StoredResponse {
+  std::string mime_type;
+  std::string encoding;
+  std::string body;
+};
+
+BASE_EXPORT bool IsRecordingResponses();
+BASE_EXPORT bool IsReplayingResponses();
+
+BASE_EXPORT void RecordResponse(const std::string& url,
+                                const std::string& mime_type,
+                                const std::string& encoding,
+                                const char* data,
+                                size_t size);
+
+// False on a miss; the caller must treat that as a divergence (RULES.md #14).
+BASE_EXPORT bool LookupResponse(const std::string& url, StoredResponse* out);
+
+}  // namespace base::sbxdiff
+
+#endif  // BASE_SBXDIFF_NET_STORE_H_
