+    ScopedOverride* handle) {
+  base::AutoLock auto_lock(lock_);
+  auto client_it = requested_ticks_by_client_.find(handle);
+  CHECK(client_it != requested_ticks_by_client_.end());
+  if (!client_it->second.has_value()) {
+    return;
+  }
+  client_it->second = std::nullopt;
+
+  // Dropping the last constraint can unblock everyone else, so re-evaluate and
+  // wake the clients that were waiting behind this one.
+  const std::optional<base::TimeTicks> min_requested = MinRequestedTicks();
+  if (!min_requested.has_value()) {
+    return;
+  }
+  const auto previous_ticks = current_ticks_.load(std::memory_order_relaxed);
+  if (*min_requested <= previous_ticks) {
+    return;
+  }
+  current_ticks_.store(*min_requested, std::memory_order_release);
+  for (const auto& entry : requested_ticks_by_client_) {
+    entry.first->ScheduleWork();
+  }
