+      []() -> std::optional<std::array<uint8_t, 32>> {
+    const CommandLine* cmd = CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch(switches::kSbxdiffRunKey)) {
+      return std::nullopt;
+    }
+    // Any string is accepted, because the key is SHA-256 of the switch value.
+    // An earlier version parsed a decimal integer, which meant a non-numeric
+    // key was silently ignored and the run fell back to real OS entropy --
+    // indistinguishable from a genuine divergence. Presence of the switch,
+    // not the shape of its value, is what enables determinism (RULES.md #13).
+    std::string material = cmd->GetSwitchValueASCII(switches::kSbxdiffRunKey);
+
+    // The process identity MUST be mixed in. stream_id is a per-process
+    // counter, so without this every renderer's main thread got stream 16 at
+    // draw 0 and therefore generated the *same* byte sequence -- including the
+    // same base::Uuid::GenerateRandomV4() values. Blob UUIDs are registered in
+    // the browser process, shared across renderers, so the second renderer to
+    // register hit a duplicate and was killed:
+    //
+    //   Terminating render process for bad Mojo message:
+    //     Invalid UUID passed to BlobRegistry::Register
+    //
+    // Measured on rateyourmusic.com: 1 such kill with --sbxdiff-run-key, 0
+    // without. It killed the Cloudflare challenge iframe, so the page could
+    // never pass. Any multi-process site would hit this.
+    //
