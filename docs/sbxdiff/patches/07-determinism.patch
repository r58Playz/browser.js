diff --git a/base/sbxdiff_rand_stream.h b/base/sbxdiff_rand_stream.h
new file mode 100644
index 0000000000000..3b4e9a51849b9
--- /dev/null
+++ b/base/sbxdiff_rand_stream.h
@@ -0,0 +1,73 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_SBXDIFF_RAND_STREAM_H_
+#define BASE_SBXDIFF_RAND_STREAM_H_
+
+#include <stdint.h>
+
+#include "base/base_export.h"
+
+namespace base {
+
+// sbxdiff: selects a dedicated keystream for the deterministic PRNG.
+//
+// Why this exists. The keyed PRNG in rand_util_posix.cc derives each draw from
+// (run_key, stream_id, draw_index), with stream_id assigned per *thread*. That
+// makes streams independent of each other, but it puts every draw on a given
+// thread into one counter -- including Chromium's own internal draws. The
+// renderer main thread does a variable number of internal draws before a page
+// runs, so the page's first getRandomValues() landed at a different
+// draw_index from run to run. Measured: 3 distinct results in 5 runs, and one
+// run's first draw equalled another run's second, which is the signature of a
+// shifted counter rather than a changed key.
+//
+// Entering an explicit stream gives the enclosed draws their own counter, so
+// they are a pure function of (run_key, stream_id, n-th draw in that stream)
+// and cannot be shifted by unrelated activity on the same thread.
+//
+// Stream ids 1..15 are reserved for explicit streams; per-thread automatic ids
+// start at 16 so they can never collide.
+//
+// NOTE: implemented in rand_util_posix.cc only. This project builds macOS; the
+// Windows and Fuchsia rand_util implementations would need the same hook.
+enum : uint32_t {
+  // Web-exposed randomness: crypto.getRandomValues and crypto.randomUUID.
+  // These are the draws a page can actually see, so they get the one stream
+  // whose contents must be reproducible.
+  kSbxdiffStreamWebCrypto = 1,
+
+  // The `----WebKitFormBoundary<16 random chars>` of a multipart/form-data
+  // POST. Not web-exposed in the sense above -- a page cannot read it back --
+  // but it is in the BYTES the page sends, which is the strongest thing
+  // sbxdiff compares. Measured on rateyourmusic's /httprequest/SecChk: two
+  // oracle runs produced 2450-byte bodies that agreed on all but 28 bytes,
+  // and those 28 were the boundary appearing twice.
+  kSbxdiffStreamFormBoundary = 2,
+
+  // TimeClamper's per-process `secret_`. Every DOMHighResTimeStamp a page can
+  // read -- performance.now(), Event.timeStamp, every entry in the resource
+  // timing buffer -- is rounded up or down by a coin flip keyed on this, so an
+  // unpinned secret makes every one of them differ by one 100 us bucket between
+  // two otherwise identical runs.
+  kSbxdiffStreamTimeClamper = 3,
+
+  // First automatic (per-thread) stream id.
+  kSbxdiffFirstAutoStream = 16,
+};
+
+class BASE_EXPORT SbxdiffScopedRandStream {
+ public:
+  explicit SbxdiffScopedRandStream(uint32_t stream_id);
+  SbxdiffScopedRandStream(const SbxdiffScopedRandStream&) = delete;
+  SbxdiffScopedRandStream& operator=(const SbxdiffScopedRandStream&) = delete;
+  ~SbxdiffScopedRandStream();
+
+ private:
+  const uint32_t previous_;
+};
+
+}  // namespace base
+
+#endif  // BASE_SBXDIFF_RAND_STREAM_H_
