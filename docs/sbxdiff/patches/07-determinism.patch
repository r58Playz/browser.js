+base::TimeTicks Performance::EffectiveTimeOrigin() const {
+#if BUILDFLAG(SBXDIFF)
+  // sbxdiff: resolve the origin at USE, not at construction.
+  //
+  // `WindowPerformance` pins its origin to the instant virtual time began, but
+  // with --sbxdiff-virtual-time-after the clock starts when the realm under
+  // test appears -- which can be AFTER the window's Performance object was
+  // built. The constructor then found no base and fell back to the loader's
+  // reference time, which is real and lands a variable ~15-25 ms in.
+  //
+  // Everything downstream inherits that: `performance.now()` read 101.9 in one
+  // run of unmodified Chromium and 77.7 in the next, and `Event.timeStamp`
+  // moved with it, while `Date.now()` -- on the same virtual clock -- was
+  // identical to the millisecond. Anti-bot payloads carry those numbers, which
+  // is why two oracle runs disagreed on 6 of 8 request bodies.
+  //
+  // Reading it here costs a load and makes a late base apply to the whole run.
+  const base::TimeTicks sbx_base = sbxdiff::GetVirtualTimeBase();
+  if (!sbx_base.is_null()) {
