+    LOG(WARNING) << "sbxdiff: Page ctor, vtc="
+                 << (page_scheduler_->GetVirtualTimeController() ? "yes" : "no")
+                 << " switch="
+                 << (base::CommandLine::ForCurrentProcess()->HasSwitch(
+                         ::switches::kSbxdiffInitialTime)
