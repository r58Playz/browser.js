+ProcessTimeOverrideCoordinator::MinRequestedTicks() const {
+  std::optional<base::TimeTicks> min;
+  for (const auto& entry : requested_ticks_by_client_) {
+    if (!entry.second.has_value()) {
+      continue;
+    }
+    if (!min.has_value() || *entry.second < *min) {
+      min = entry.second;
+    }
+  }
