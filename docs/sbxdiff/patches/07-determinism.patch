+    // second registrant can pin the clock forever (RULES.md #12).
+    const base::CommandLine* sbx_cmd = base::CommandLine::ForCurrentProcess();
+    // --sbxdiff-virtual-time-after defers this to the realm that matches, so
+    // harness/service-worker setup runs on the real clock. See
