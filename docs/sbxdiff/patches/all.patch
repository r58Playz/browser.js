+#include "chrome/browser/headless/sbxdiff_net_replay.h"
+
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/base_switches.h"
+#include "base/byte_size.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sbxdiff_body_hash.h"
+#include "base/sbxdiff_net_store.h"
+#include "base/strings/strcat.h"
+#include "base/task/sequenced_task_runner.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "mojo/public/cpp/system/data_pipe_drainer.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_util.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/parsed_headers.h"
+#include "services/network/public/cpp/data_element.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/resource_request_body.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+#include "services/network/public/mojom/early_hints.mojom.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_loader_factory.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace sbxdiff {
+
+namespace {
+
+// Records a response in the BROWSER process, by sitting between the network
+// service and the renderer.
+//
+// Renderer-side probes cannot do this. A cross-origin response without CORS is
+// opaque: the renderer never receives its bytes, so a probe has nothing to
+// record. Measured on rateyourmusic, 20 of 78 requested URLs never reached the
+// store that way -- every web font, a no-cors analytics beacon, and two
+// Cloudflare challenge endpoints among them. A replay then blocks requests the
+// recording had no trouble with, and an anti-bot challenge that depends on them
+// cannot pass.
+//
+// The body is buffered and forwarded once complete rather than teed
+// incrementally. That trades streaming for a great deal less flow-control
+// machinery; a recording run is not timing-critical, and the bytes the page
+// finally sees are identical.
+class RecordingClient : public network::mojom::URLLoaderClient,
+                        public mojo::DataPipeDrainer::Client {
+ public:
+  // Self-owned, but NOT via MakeSelfOwnedReceiver: that deletes on pipe
+  // disconnect, and the network service closes its end as soon as it has sent
+  // OnComplete -- while the drainer is still reading asynchronously. The
+  // response then never reaches the renderer and the page simply does not load.
+  // Lifetime has to outlive delivery, not the pipe.
+  static void Create(GURL url,
+                     std::string request_body,
+                     mojo::PendingReceiver<network::mojom::URLLoaderClient> recv,
+                     mojo::PendingRemote<network::mojom::URLLoaderClient> real) {
+    auto* self = new RecordingClient(std::move(url), std::move(request_body),
+                                     std::move(real));
+    self->receiver_.Bind(std::move(recv));
+    self->receiver_.set_disconnect_handler(base::BindOnce(
+        &RecordingClient::OnUpstreamGone, base::Unretained(self)));
+  }
+
+  RecordingClient(GURL url,
+                  std::string request_body,
+                  mojo::PendingRemote<network::mojom::URLLoaderClient> real)
+      : url_(std::move(url)),
+        request_body_(std::move(request_body)),
+        real_(std::move(real)) {}
+
+  RecordingClient(const RecordingClient&) = delete;
+  RecordingClient& operator=(const RecordingClient&) = delete;
+  ~RecordingClient() override = default;
+
+  // network::mojom::URLLoaderClient:
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr hints) override {
+    real_->OnReceiveEarlyHints(std::move(hints));
+  }
+
+  void OnReceiveResponse(network::mojom::URLResponseHeadPtr head,
+                         mojo::ScopedDataPipeConsumerHandle body,
+                         std::optional<mojo_base::BigBuffer> metadata) override {
+    if (head) {
+      mime_type_ = head->mime_type;
+      charset_ = head->charset;
+      raw_headers_ = head->headers ? head->headers->raw_headers() : std::string();
+    }
+    head_ = std::move(head);
+    metadata_ = std::move(metadata);
+    if (!body) {
+      Deliver();
+
+      return;
+    }
+    drainer_ = std::make_unique<mojo::DataPipeDrainer>(this, std::move(body));
+  }
+
+  void OnReceiveRedirect(const net::RedirectInfo& info,
+                         network::mojom::URLResponseHeadPtr head) override {
+    // A redirect is a recording of its own, under the URL that produced it.
+    //
+    // Following the chain silently and storing only the final body loses the
+    // fact that the page moved, and the URL it moved to. Cloudflare's managed
+    // challenge sends `/` -> `/?__cf_chl_rt_tk=<token>`, and the challenge
+    // script reads that token out of `location`; a replay that answers `/` with
+    // the challenge body directly runs the script at a URL with no token.
+    if (head) {
+      base::sbxdiff::RecordResponse(
+          url_.spec(), head->mime_type, head->charset,
+          head->headers ? head->headers->raw_headers() : std::string(),
+          request_body_, /*data=*/nullptr, /*size=*/0);
+    }
+    url_ = info.new_url;
+    real_->OnReceiveRedirect(info, std::move(head));
+  }
+
+  void OnUploadProgress(int64_t current,
+                        int64_t total,
+                        OnUploadProgressCallback callback) override {
+    real_->OnUploadProgress(current, total, std::move(callback));
+  }
+
+  void OnTransferSizeUpdated(int32_t diff) override {
+    real_->OnTransferSizeUpdated(diff);
+  }
+
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    completion_ = status;
+    if (delivered_) {
+      real_->OnComplete(status);
+      Finish();
+    }
+  }
+
+  // mojo::DataPipeDrainer::Client:
+  void OnDataAvailable(base::span<const uint8_t> data) override {
+    body_.append(reinterpret_cast<const char*>(data.data()), data.size());
+  }
+
+  void OnDataComplete() override { Deliver(); }
+
+ private:
+  // Upstream finished and dropped us. Deliver whatever was drained; if the
+  // drain never started there is nothing to wait for.
+  void OnUpstreamGone() {
+    upstream_gone_ = true;
+    if (!drainer_ || delivered_) {
+      Deliver();
+      Finish();
+    }
+  }
+
+  void Finish() {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    // Deleting inline would unwind through the mojo dispatch that called us.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  void Deliver() {
+    if (delivered_) {
+      return;
+    }
+    delivered_ = true;
+    base::sbxdiff::RecordResponse(url_.spec(), mime_type_, charset_,
+                                  raw_headers_, request_body_, body_.data(),
+                                  body_.size());
+
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    const MojoCreateDataPipeOptions options = {
+        sizeof(MojoCreateDataPipeOptions), MOJO_CREATE_DATA_PIPE_FLAG_NONE, 1,
+        static_cast<uint32_t>(body_.empty() ? 1 : body_.size())};
+    if (mojo::CreateDataPipe(&options, producer, consumer) != MOJO_RESULT_OK) {
+      real_->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_INSUFFICIENT_RESOURCES));
+
+      return;
+    }
+    real_->OnReceiveResponse(std::move(head_), std::move(consumer),
+                             std::move(metadata_));
+    if (!body_.empty()) {
+      // The pipe was sized to the body, so one write suffices.
+      size_t written = 0;
+      producer->WriteData(base::as_byte_span(body_), MOJO_WRITE_DATA_FLAG_NONE,
+                          written);
+    }
+    producer.reset();
+    if (completion_) {
+      real_->OnComplete(*completion_);
+    }
+    if (upstream_gone_) {
+      Finish();
+    }
+  }
+
+  GURL url_;
+  std::string request_body_;
+  mojo::Remote<network::mojom::URLLoaderClient> real_;
+  network::mojom::URLResponseHeadPtr head_;
+  std::optional<mojo_base::BigBuffer> metadata_;
+  std::optional<network::URLLoaderCompletionStatus> completion_;
+  std::unique_ptr<mojo::DataPipeDrainer> drainer_;
+  std::string mime_type_;
+  std::string charset_;
+  std::string raw_headers_;
+  std::string body_;
+  bool delivered_ = false;
+  bool upstream_gone_ = false;
+  bool finished_ = false;
+  mojo::Receiver<network::mojom::URLLoaderClient> receiver_{this};
+};
+
+// The request body, as far as it can be read without consuming it.
+//
+// Only `kBytes` elements are readable here: a data pipe would have to be
+// drained, and draining it is what the network service is about to do. A body
+// that arrives as a pipe is recorded as an empty string and compares equal to
+// anything, which is a gap, not a pass -- see the mismatch check in
+// ReplayLoader::Serve.
+std::string ReadableRequestBody(const network::ResourceRequest& request) {
+  if (!request.request_body) {
+    return std::string();
+  }
+  std::string out;
+  for (const network::DataElement& element : *request.request_body->elements()) {
+    if (element.type() != network::DataElement::Tag::kBytes) {
+      continue;
+    }
+    const auto& bytes = element.As<network::DataElementBytes>().bytes();
+    out.append(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+  }
+  return out;
+}
+
+// Rebuilds the response head from a recording.
+//
+// The recorded headers are replayed verbatim, not summarised into a synthetic
+// `200 OK`. What a page does depends on them: `Critical-CH` makes Chromium
+// restart the navigation (so the store's ordinal 0 and 1 are two different
+// challenge instances, and only the second is the one whose sub-requests were
+// recorded), `Location` moves the document, `Content-Type` and CSP change how
+// the body is treated. A store written before headers existed still replays,
+// under the old synthetic head.
+network::mojom::URLResponseHeadPtr MakeHead(
+    const base::sbxdiff::StoredResponse& stored,
+    const GURL& url) {
+  auto head = network::mojom::URLResponseHead::New();
+  if (stored.raw_headers.empty()) {
+    head->headers = base::MakeRefCounted<net::HttpResponseHeaders>(
+        net::HttpUtil::AssembleRawHeaders(base::StrCat(
+            {"HTTP/1.1 200 OK\r\nContent-Type: ", stored.mime_type, "\r\n\r\n"})));
+  } else {
+    head->headers =
+        base::MakeRefCounted<net::HttpResponseHeaders>(stored.raw_headers);
+  }
+  head->mime_type = stored.mime_type;
+  head->charset = stored.encoding;
+  head->content_length = static_cast<int64_t>(stored.body.size());
+  head->request_time = base::Time::Now();
+  head->response_time = base::Time::Now();
+  // Populated because the browser reads it, not the renderer: the Critical-CH
+  // navigation restart is driven off parsed_headers, and a null one means the
+  // restart never happens and the replay diverges from the recording at the
+  // very first response.
+  head->parsed_headers =
+      network::PopulateParsedHeaders(head->headers.get(), url);
+  return head;
+}
+
+// Serves one request, and the redirect chain it turns into, out of the store.
+//
+// Stateful because a redirect is not a response: the client has to be told to
+// follow it and comes back through FollowRedirect(), at which point the next
+// recording -- keyed by the *new* URL -- is what it gets.
+class ReplayLoader : public network::mojom::URLLoader {
+ public:
+  static void Create(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const network::ResourceRequest& request) {
+    auto* self = new ReplayLoader(std::move(client), request);
+    self->receiver_.Bind(std::move(loader));
+    self->receiver_.set_disconnect_handler(
+        base::BindOnce(&ReplayLoader::Finish, base::Unretained(self)));
+    self->Serve();
+  }
+
+  ReplayLoader(const ReplayLoader&) = delete;
+  ReplayLoader& operator=(const ReplayLoader&) = delete;
+  // Public for DeleteSoon; construction still goes through Create().
+  ~ReplayLoader() override = default;
+
+  // network::mojom::URLLoader:
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams,
+                      const std::optional<GURL>& new_url) override {
+    if (new_url) {
+      url_ = *new_url;
+    }
+    Serve();
+  }
+
+  void SetPriority(net::RequestPriority, int32_t) override {}
+
+ private:
+  ReplayLoader(mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+               const network::ResourceRequest& request)
+      : client_(std::move(client)),
+        url_(request.url),
+        request_body_(ReadableRequestBody(request)),
+        method_(request.method),
+        site_for_cookies_(request.site_for_cookies),
+        referrer_(request.referrer),
+        referrer_policy_(request.referrer_policy),
+        initiator_(request.request_initiator),
+        is_outermost_main_frame_(request.is_outermost_main_frame) {}
+
+  void Finish() {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  void Fail(int error) {
+    client_->OnComplete(network::URLLoaderCompletionStatus(error));
+    Finish();
+  }
+
+  void Serve() {
+    base::sbxdiff::StoredResponse stored;
+    size_t ordinal = 0;
+    if (!base::sbxdiff::LookupNextResponse(url_.spec(), &stored, &ordinal)) {
+      // Loud: a miss here is a divergence, and a silent one looks exactly like
+      // the page misbehaving. The post-challenge navigation missing produced a
+      // 109-iteration retry loop with no diagnostic anywhere.
+      LOG(WARNING) << "sbxdiff: replay MISS #" << ordinal << " " << url_.spec();
+      if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+              ::switches::kSbxdiffNetReplaySoftMiss)) {
+        // Replay miss: fail rather than fall through to the network. Silently
+        // fetching would break hermeticity, which is the whole point.
+        Fail(net::ERR_BLOCKED_BY_CLIENT);
+        return;
+      }
+      // Serve nothing rather than refusing. Still counted above; refusing is
+      // itself a behaviour the recording never exhibited.
+      stored = base::sbxdiff::StoredResponse();
+      stored.mime_type = "text/plain";
+    }
+
+    // Was this verdict graded on THIS answer?
+    //
+    // A store cannot grade a request, so an anti-bot endpoint's recorded "you
+    // passed" comes back whatever was posted to it. Comparing the body against
+    // the one the recording sent is what tells "the sandbox produced the same
+    // answer" apart from "the store told it whatever it wanted to hear".
+    //
+    // Logged for EVERY request that carries a body, not only on a mismatch
+    // against the recording, because the recording is the wrong thing to hold
+    // either side to. Measured on rateyourmusic: unmodified Chromium replaying
+    // this store sends 2263 bytes where the recording sent 2274, and mismatches
+    // on all five of the endpoints the sandbox does. Cloudflare's payload is
+    // built from the clock and from entropy drawn during the run, so the bytes
+    // are not reproducible across runs BY ANYONE -- holding the sandbox to them
+    // scores it against noise. The comparison that means something is oracle
+    // against sandbox, and that needs this side's hash to exist at all.
+    if (!request_body_.empty()) {
+      LOG(WARNING) << "sbxdiff: replay REQBODY #" << ordinal << " "
+                   << base::sbxdiff::BodyHash(request_body_) << " " << url_.spec();
+      if (!stored.request_body.empty() &&
+          request_body_ != stored.request_body) {
+        LOG(WARNING) << "sbxdiff: replay BODY MISMATCH #" << ordinal << " sent "
+                     << request_body_.size() << "b vs recorded "
+                     << stored.request_body.size() << "b " << url_.spec();
+      }
+    }
+
+    auto head = MakeHead(stored, url_);
+    std::string location;
+    if (head->headers && head->headers->IsRedirect(&location)) {
+      const GURL new_location = url_.Resolve(location);
+      if (!new_location.is_valid()) {
+        Fail(net::ERR_INVALID_REDIRECT);
+        return;
+      }
+      const net::RedirectInfo info = net::RedirectInfo::ComputeRedirectInfo(
+          method_, url_, site_for_cookies_,
+          is_outermost_main_frame_
+              ? net::RedirectInfo::FirstPartyURLPolicy::UPDATE_URL_ON_REDIRECT
+              : net::RedirectInfo::FirstPartyURLPolicy::NEVER_CHANGE_URL,
+          referrer_policy_, referrer_.spec(), initiator_,
+          head->headers->response_code(), new_location,
+          head->headers->GetNormalizedHeader("Referrer-Policy"),
+          /*insecure_scheme_was_upgraded=*/false);
+      url_ = info.new_url;
+      method_ = info.new_method;
+      site_for_cookies_ = info.new_site_for_cookies;
+      referrer_ = GURL(info.new_referrer);
+      referrer_policy_ = info.new_referrer_policy;
+      client_->OnReceiveRedirect(info, std::move(head));
+      // The client comes back through FollowRedirect(), or drops us.
+      return;
+    }
+
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    if (mojo::CreateDataPipe(stored.body.size() + 1, producer, consumer) !=
+        MOJO_RESULT_OK) {
+      Fail(net::ERR_INSUFFICIENT_RESOURCES);
+      return;
+    }
+
+    client_->OnReceiveResponse(std::move(head), std::move(consumer),
+                               std::nullopt);
+
+    // The pipe was sized to the body, so a single write suffices.
+    if (!stored.body.empty()) {
+      size_t written = 0;
+      producer->WriteData(base::as_byte_span(stored.body),
+                          MOJO_WRITE_DATA_FLAG_NONE, written);
+    }
+    producer.reset();
+
+    network::URLLoaderCompletionStatus status(net::OK);
+    status.encoded_data_length = base::ByteSize(stored.body.size());
+    status.decoded_body_length = base::ByteSize(stored.body.size());
+    client_->OnComplete(status);
+    // Deliberately NOT deleted here: the client keeps its URLLoader handle for
+    // the lifetime of the request and a dead receiver looks like a crash.
+  }
+
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  GURL url_;
+  std::string request_body_;
+  std::string method_;
+  net::SiteForCookies site_for_cookies_;
+  GURL referrer_;
+  net::ReferrerPolicy referrer_policy_;
+  std::optional<url::Origin> initiator_;
+  bool is_outermost_main_frame_ = false;
+  bool finished_ = false;
+  mojo::Receiver<network::mojom::URLLoader> receiver_{this};
+};
+
+// Forwards every request to the real factory, recording what comes back.
+class RecordingFactory : public network::mojom::URLLoaderFactory {
+ public:
+  static void Create(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target) {
+    auto* factory = new RecordingFactory(std::move(target));
+    factory->receivers_.Add(factory, std::move(receiver));
+    factory->receivers_.set_disconnect_handler(base::BindRepeating(
+        &RecordingFactory::OnDisconnect, base::Unretained(factory)));
+  }
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+    mojo::PendingRemote<network::mojom::URLLoaderClient> recording;
+    RecordingClient::Create(request.url, ReadableRequestBody(request),
+                            recording.InitWithNewPipeAndPassReceiver(),
+                            std::move(client));
+    target_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                  request, std::move(recording), annotation);
+  }
+
+  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      override {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+ private:
+  explicit RecordingFactory(
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target)
+      : target_(std::move(target)) {}
+
+  void OnDisconnect() {
+    if (receivers_.empty()) {
+      delete this;
+    }
+  }
+
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> receivers_;
+};
+
+class ReplayFactory : public network::mojom::URLLoaderFactory {
+ public:
+  static void Create(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+    // Owned by its ReceiverSet; deleted when the last client disconnects.
+    auto* factory = new ReplayFactory();
+    factory->receivers_.Add(factory, std::move(receiver));
+    factory->receivers_.set_disconnect_handler(base::BindRepeating(
+        &ReplayFactory::OnDisconnect, base::Unretained(factory)));
+  }
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+    ReplayLoader::Create(std::move(loader), std::move(client), request);
+  }
+
+  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      override {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+ private:
+  ReplayFactory() = default;
+  ~ReplayFactory() override = default;
+
+  void OnDisconnect() {
+    if (receivers_.empty()) {
+      delete this;
+    }
+  }
+
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> receivers_;
+};
+
+}  // namespace
+
+void MaybeInstallReplayInterceptor(network::URLLoaderFactoryBuilder& builder) {
+  if (base::sbxdiff::IsRecordingResponses()) {
+    // Record here rather than in the renderer: an opaque cross-origin response
+    // never reaches the renderer at all.
+    auto [receiver, remote] = builder.Append();
+    RecordingFactory::Create(std::move(receiver), std::move(remote));
+
+    return;
+  }
+  if (!base::sbxdiff::IsReplayingResponses()) {
+    return;
+  }
+  auto [receiver, unused_remote] = builder.Append();
+  // The remote is dropped deliberately: strict replay never forwards.
+  ReplayFactory::Create(std::move(receiver));
+}
+
+}  // namespace sbxdiff
