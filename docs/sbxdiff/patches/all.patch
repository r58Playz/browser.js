new file mode 100644
index 0000000000000..c818ab70e9270
--- /dev/null
+++ b/third_party/blink/renderer/core/sbxdiff/sbxdiff_net_observer.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/sbxdiff/sbxdiff_net_observer.h"
+
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/probe/core_probes.h"
+#include "third_party/blink/renderer/platform/loader/fetch/resource_response.h"
+#include "base/sbxdiff_net_store.h"
+
+namespace blink {
+
+SbxdiffNetObserver::SbxdiffNetObserver(LocalFrame* local_root)
+    : local_root_(local_root) {
+  local_root_->GetProbeSink()->AddSbxdiffNetObserver(this);
+}
+
+void SbxdiffNetObserver::Shutdown() {
+  if (!local_root_) {
+    return;
+  }
+  local_root_->GetProbeSink()->RemoveSbxdiffNetObserver(this);
+  local_root_ = nullptr;
+}
+
+void SbxdiffNetObserver::DidReceiveResourceResponse(
+    uint64_t identifier,
+    DocumentLoader*,
+    const ResourceResponse& response,
+    const Resource*) {
+  if (!base::sbxdiff::IsRecordingResponses()) {
+    return;
+  }
+  Pending pending;
+  pending.url = response.CurrentRequestUrl().GetString();
+  pending.mime_type = response.MimeType();
+  pending.encoding = response.TextEncodingName();
+  pending_.Set(identifier, std::move(pending));
+}
+
+void SbxdiffNetObserver::DidReceiveData(uint64_t identifier,
+                                        DocumentLoader*,
+                                        base::SpanOrSize<const char> data) {
+  if (!base::sbxdiff::IsRecordingResponses()) {
+    return;
+  }
+  auto it = pending_.find(identifier);
+  if (it == pending_.end()) {
+    return;
+  }
+  // This is the call that makes fetch()/XHR recordable: the bytes arrive here
+  // even when the Resource itself never buffers them.
+  if (auto span = data.span(); span) {
+    // WTF Vector has no AppendSpan; Append(begin, end) is the iterator form.
+    it->value.body.Append(span->begin(), span->end());
+  }
+}
+
+void SbxdiffNetObserver::DidFinishLoading(uint64_t identifier,
+                                         DocumentLoader*,
+                                         base::TimeTicks,
+                                         int64_t,
+                                         int64_t) {
+  if (!base::sbxdiff::IsRecordingResponses()) {
+    return;
+  }
+  auto it = pending_.find(identifier);
+  if (it == pending_.end()) {
+    return;
+  }
+  const Pending& pending = it->value;
+  base::sbxdiff::RecordResponse(pending.url.Utf8(), pending.mime_type.Utf8(),
+                                pending.encoding.Utf8(), pending.body.data(),
+                                pending.body.size());
+  pending_.erase(it);
+}
+
+void SbxdiffNetObserver::Trace(Visitor* visitor) const {
+  visitor->Trace(local_root_);
+}
+
+}  // namespace blink
