+namespace {
+// Set once, on the main thread, before any document exists.
+base::TimeTicks g_virtual_time_base;
+}  // namespace
+
+int VirtualTimePolicyFromSwitch() {
+  // 0 = kAdvance, 1 = kPause, 2 = kDeterministicLoading. Returned as an int
+  // because platform/bindings must not depend on the scheduler's enum here;
+  // the two call sites map it.
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  const std::string name =
+      cmd ? cmd->GetSwitchValueASCII(::switches::kSbxdiffVirtualTimePolicy)
+          : std::string();
+  if (name == "advance") {
+    return 0;
+  }
+  if (name == "pause") {
+    return 1;
+  }
+  return 2;
+}
+
+int64_t VirtualTimeBudgetFromSwitch() {
+  int64_t budget_ms = 2000;
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd && cmd->HasSwitch(::switches::kSbxdiffVirtualTimeBudget)) {
+    std::ignore = base::StringToInt64(
+        cmd->GetSwitchValueASCII(::switches::kSbxdiffVirtualTimeBudget),
+        &budget_ms);
+  }
+  return budget_ms;
+}
+
+bool VirtualTimeIsDeferred() {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd && cmd->HasSwitch(::switches::kSbxdiffVirtualTimeAfter);
+}
+
+namespace {
+// Main thread only. Virtual time is a page-scheduler property and the only
+// caller is local_window_proxy.cc, which runs on the main thread, so a plain
+// bool needs no synchronisation. It is not thread_local because there is one
+// page clock, not one per thread -- but a worker thread must not read it.
+bool g_virtual_time_started = false;
+}  // namespace
+
+bool VirtualTimeHasStarted() {
+  return g_virtual_time_started;
+}
+
+void MarkVirtualTimeStarted() {
+  g_virtual_time_started = true;
+}
+
+bool IsVirtualTimeStartRealm(const std::string& url) {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd || !cmd->HasSwitch(::switches::kSbxdiffVirtualTimeAfter)) {
+    return false;
+  }
+  const std::string want =
+      cmd->GetSwitchValueASCII(::switches::kSbxdiffVirtualTimeAfter);
+  return !want.empty() && url.find(want) != std::string::npos;
+}
+
+void SetVirtualTimeBase(base::TimeTicks base) {
+  g_virtual_time_base = base;
+}
+
+base::TimeTicks GetVirtualTimeBase() {
+  return g_virtual_time_base;
+}
