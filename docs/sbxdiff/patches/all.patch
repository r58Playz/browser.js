+inline constexpr char kSbxdiffClick[] = "sbxdiff-click";
+
+// sbxdiff: periodic viewport screenshots: --sbxdiff-shots=<dir>[,interval_ms].
+//
+// Captured in-browser via RenderWidgetHostView::CopyFromSurface rather than
