+//
+// sbxdiff: the trace sink for the browser.js/scramjet differential oracle.
+//
+// Lives in platform/bindings/ rather than core/ on purpose: bind_gen emits the
+// BLINK_BINDINGS_TRACE_EVENT macro into BOTH bindings/core/v8 (549 files) and
+// bindings/modules/v8 (603 files), and blink_platform is the only component
+// visible to both. See docs/sbxdiff/ARCHITECTURE.md.
+//
+// HARD RULE (docs/sbxdiff/RULES.md #1): nothing reachable from here may execute
+// page JS. The encoder body runs inside a DisallowJavascriptExecutionScope with
+// kCrashOnFailure in DCHECK builds so that is enforced mechanically rather than
+// by review.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_TRACER_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_TRACER_H_
+
+#include <cstdint>
+#include <memory>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/time/time.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "third_party/blink/renderer/platform/wtf/hash_map.h"
+#include "third_party/blink/renderer/platform/wtf/hash_set.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "v8/include/v8-forward.h"
+
+namespace blink::sbxdiff {
+
+// Record kinds. Wire values are stable; append only.
+// Bumped to 2 when kBindingCall gained arguments. A decoder that reads v1
+// cannot read v2: the argument block sits between the result and the end of
+// the record.
+//
+// Bumped to 3 when every compared record gained script attribution: a
+// `top_script` and an `entry_script` varint after the task id. In a sandbox the
+// shim and the guest share one realm, so without this there is no way to tell
+// a native call the guest made from one the shim made on its own initiative.
+enum class RecordKind : uint8_t {
+  kIntern = 0,       // id -> string, emitted on first use of a name
+  kBindingCall = 1,  // one generated binding callback
+  kInterceptor = 2,  // one named/indexed property interceptor callback
+  kRealm = 3,        // realm id -> document URL, emitted when a realm is set up
+  kInterceptorOutcome = 4,  // did interceptor record <seq> intercept or decline
+  kNetRequest = 5,   // one resource request, and whether the gate blocked it
+  kException = 6,    // a binding threw: ExceptionCode + message
+  kScript = 7,       // V8 script id -> script URL, on first sighting
+};
+
+// Comparison level. The `level` byte IS the cut described in ARCHITECTURE.md:
+// the differ reads only kCompared, while kInternal records stay in the same
+// ordered stream for post-mortem attribution.
+enum class Level : uint8_t {
+  kCompared = 0,
+  kInternal = 1,  // demoted: nested inside a guest-op bracket
+  kDebug = 2,
+};
+
+// Value type tags. Identity and shape only -- never contents (RULES.md #2).
+enum class ValueTag : uint8_t {
+  kUndefined = 0,
+  kNull = 1,
+  kBool = 2,
+  kNumber = 3,
+  kString = 4,   // length + hash, not bytes, for long strings
+  kBigInt = 5,
+  kSymbol = 6,
+  kObject = 7,   // object id + constructor name id
+  kDomWrapper = 8,  // object id + WrapperTypeInfo interface name id
+  kFunction = 9,
+  kProxy = 10,
+  kOpaque = 11,  // could not be encoded without risking JS execution
+};
+
+// Per-thread trace sink. Blink runs one isolate per thread, so thread-local is
+// both correct and cheaper than a per-isolate map.
+class PLATFORM_EXPORT SbxTracer {
+  USING_FAST_MALLOC(SbxTracer);
+
+ public:
+  // Null unless --sbxdiff-trace-out was passed. Callers must null-check; the
+  // hot path in sbx_scope.h does so before doing any work at all.
+  static SbxTracer* Get();
+
+  // Bisection aid for --sbxdiff-debug-disable=<mask>; bit 16 makes the scopes
+  // skip their destructor body entirely, which is the only way to separate
+  // "a tracer exists" from "the scope reads GetReturnValue()/This()".
+  // Not part of the oracle; a traced run leaves the switch unset.
+  static bool ScopeWorkDisabled();
+
+  // Returns the tracer for this thread only if one already exists. Unlike
+  // Get(), never creates one (and so never opens a trace file).
+  static SbxTracer* GetIfExists();
+
+  // Records a realm's URL, deferring if this thread has no tracer yet.
+  //
+  // The realm hooks run during context initialization, which is *before* the
+  // thread has necessarily run any JS. Calling Get() there would create a
+  // tracer -- and open a trace file -- on threads that may never record
+  // anything. A worker thread whose script fails to load is exactly that case,
+  // and it hung the run 5/5 (PROGRESS.md M4 part 3). So when no tracer exists,
+  // the URL is stashed and emitted with this thread's first real record, whose
+  // realm is the one being initialized here.
+  static void NoteRealmForContext(v8::Isolate* isolate,
+                                  v8::Local<v8::Object> global,
+                                  std::string_view url);
+
+  // True if tracing was requested for this process. Cheap; safe before Get().
+  static bool IsEnabled();
+
+  SbxTracer(const SbxTracer&) = delete;
+  SbxTracer& operator=(const SbxTracer&) = delete;
+  ~SbxTracer();
+
+  // Records one generated binding callback. `name` must be a string literal
+  // with static storage duration -- interning is keyed on the pointer, which
+  // is what makes this O(1) and 4 bytes on the wire.
+  void TraceBindingCall(const char* name,
+                        v8::Isolate* isolate,
+                        v8::Local<v8::Value> receiver,
+                        v8::Local<v8::Value> result,
+                        bool threw,
+                        uint32_t argc_total,
+                        base::span<const v8::Local<v8::Value>> args);
+
+  // Records one interceptor callback (named/indexed property getter, setter,
+  // deleter, definer, descriptor, query, enumerator). Entry-only: these return
+  // v8::Intercepted and whether the interceptor *declined* is not visible to a
+  // destructor, and PropertyCallbackInfo<void> (IndexOf) has no usable return
+  // value at all. Capturing the decline outcome needs the rename-to-Impl plus
+  // wrapper approach; recording the consultation and its key is already far
+  // more than the zero coverage these had.
+  // `value` is empty for reads and set for setter/definer interceptors, where
+  // it is the value being written. Without it a named set records only the key.
+  void TraceInterceptorNamed(const char* name,
+                             v8::Isolate* isolate,
+                             v8::Local<v8::Value> receiver,
+                             v8::Local<v8::Value> key,
+                             v8::Local<v8::Value> value =
+                                 v8::Local<v8::Value>());
+  void TraceInterceptorIndexed(const char* name,
+                               v8::Isolate* isolate,
+                               v8::Local<v8::Value> receiver,
+                               uint32_t index,
+                               v8::Local<v8::Value> value =
+                                   v8::Local<v8::Value>());
+  void TraceInterceptorNoKey(const char* name,
+                             v8::Isolate* isolate,
+                             v8::Local<v8::Value> receiver);
+
+  // Associates a realm with a document URL. Called from core (which knows about
+  // Document; platform does not) when a window proxy's document is installed.
+  // Without this, trace files are only identifiable by guessing from call
+  // counts -- a run writes one file per process and there is no size heuristic.
+  void NoteRealm(v8::Isolate* isolate,
+                 v8::Local<v8::Object> global,
+                 std::string_view url);
+
+  // Records whether the interceptor whose record has seq `target_seq` handled
+  // the access or declined it. Declining (v8::Intercepted::kNo) means "fall
+  // through to the ordinary lookup" and is guest-observable, but it is a
+  // return value, so the in-body scope -- which records on entry -- cannot
+  // see it. Emitted from the registration-site wrapper in sbx_intercept.h.
+  void TraceInterceptorOutcome(uint64_t target_seq, bool intercepted);
+
+  // Seq the *next* record will take. Sampled by the interceptor wrapper before
+  // it calls the real callback, so nested interceptors (which take higher
+  // seqs) cannot steal the outcome.
+  uint64_t PeekSeq() const { return seq_; }
+
+  // Records a resource request. `blocked` means the replay gate refused it
+  // because it was not in the allow-list -- which is a *divergence*, not an
+  // error: the run must not fall through to the real network (that breaks
+  // hermeticity silently) and must not abort (that loses why it was asked for).
+  // See RULES.md #14.
+  void TraceNetRequest(std::string_view method,
+                       std::string_view url,
+                       bool blocked);
+
+  // True when --sbxdiff-net-allow is set and `url` is not in the allow-list.
+  // Always false when the switch is absent, so the gate is inert by default.
+  static bool ShouldBlockRequest(std::string_view url);
+
+  // Records a thrown binding exception.
+  //
+  // The `threw` bool on kBindingCall catches throw-vs-no-throw but not *what*
+  // was thrown, and V8 exposes a pending exception only through v8::TryCatch —
+  // installing one in the binding scope would change exception propagation,
+  // which an oracle must not do. Blink funnels every binding throw through
+  // ExceptionState::SetExceptionInfo instead, which knows the code and message
+  // before V8 ever sees them, so that is where this is called from.
+  void TraceException(int exception_code, std::string_view message);
+
+  void Flush();
+
+  uint64_t records_written() const { return records_written_; }
+
+  // Public only so ThreadSpecific<std::unique_ptr<SbxTracer>> can own one, which
+  // is what makes ~SbxTracer (and its final Flush) run on thread exit. Callers
+  // should use Get().
+  SbxTracer(base::File file, uint64_t run_key);
+
+ private:
+  uint32_t InternLiteral(const char* literal);
+
+  // V8 script id of the frame on top of the JS stack, emitting a kScript
+  // record the first time an id is seen. 0 when there is no JS on the stack
+  // (a binding reached from C++, e.g. parser-driven work).
+  //
+  // StackTrace::CurrentScriptId is the stable, allocation-free spelling --
+  // CurrentScriptIdsAndContexts is V8_DEPRECATE_SOON (fatal under Chromium's
+  // -Werror) and CurrentScriptData is flagged experimental. It cannot run JS,
+  // so it is safe under RULES.md #1.
+  uint32_t CurrentScriptId(v8::Isolate* isolate);
+  void EncodeValue(v8::Isolate* isolate, v8::Local<v8::Value> value);
+
+  // Assigns (lazily, only for values actually written to a kCompared record) a
+  // run-local id. Uses a v8::Private symbol, which is invisible to every JS
+  // enumeration and does not trip Proxy traps. See PINNED_ASSUMPTIONS.md #3.
+  uint64_t ObjectIdFor(v8::Isolate* isolate, v8::Local<v8::Object> object);
+
+  // Run-local id of the realm a record belongs to: the object id of the
+  // current context's global proxy, which is stable per realm. 0 when no
+  // context is entered.
+  uint64_t CurrentRealmId(v8::Isolate* isolate);
+
+  // Id of the task (top-level JS execution, including the microtasks drained
+  // at its end) a record belongs to.
+  //
+  // NOT from Blink's TaskAttributionTracker. That looked like the obvious
+  // source, but it is an opt-in propagation channel for SoftNavigationContext
+  // / ResourceTimingContext / WebSchedulingTaskState: its CurrentTaskState()
+  // is null whenever there is "nothing to propagate", which on an ordinary
+  // page is always. Measured 0 of 3126 records attributed before this was
+  // replaced -- see PROGRESS.md M4.
+  //
+  // Instead the id comes from V8's own call-entered/call-completed pair, which
+  // brackets exactly one top-level JS execution: BeforeCallEntered fires on
+  // every entry including re-entrance, so a fresh id is minted only on the
+  // 0 -> 1 transition and nested C++ -> JS -> C++ -> JS keeps one id;
+  // CallCompleted fires only when the outermost one ends.
+  //
+  // Microtasks need separate handling, and an earlier comment here got this
+  // wrong. V8 *would* drain the checkpoint before firing CallCompleted, but
+  // only under MicrotasksPolicy::kAuto; Blink sets kScoped
+  // (v8_initializer.cc), so Blink drains microtasks itself after call depth
+  // has already hit zero -- and V8 does not fire BeforeCallEntered for
+  // microtask jobs at all. Measured result: every promise continuation was
+  // unattributed (task 0) while script and timer tasks were correct.
+  //
+  // Fixed by opening a task lazily in the record path (EnsureTaskOpen), with
+  // CallCompleted as the only close. No microtask hook is needed, and none
+  // would have been enough anyway: v8::Isolate's microtasks-completed callback
+  // covers only the isolate's default queue, while Blink drains per-agent
+  // MicrotaskQueues.
+  //
+  // Granularity is one id per microtask *checkpoint*, not per microtask job;
+  // within a checkpoint records are still strictly ordered by seq. Per-job ids
+  // would need v8::Isolate::SetPromiseHook, a contended single-slot API whose
+  // perf cost is potentially page-observable -- deliberately not used.
+  //
+  // Do not build a generation counter off wall-clock time: the prior harness
+  // did and its own README flagged it as wrong.
+  uint64_t CurrentTaskId() const { return current_task_id_; }
+
+  // Registers the V8 callbacks above, once per tracer (one tracer per thread,
+  // one isolate per thread in Blink).
+  void EnsureIsolateHooks(v8::Isolate* isolate);
+  static void OnBeforeCallEntered(v8::Isolate* isolate);
+  static void OnCallCompleted(v8::Isolate* isolate);
+  // Emits any realm record deferred by NoteRealmForContext. Must be called
+  // *before* a record starts building: it writes a record of its own, and
+  // splicing one record into another corrupts the stream (the same bug
+  // interning caused once already).
+  void FlushPendingRealm(v8::Isolate* isolate);
+
+  // Mints a task id if none is open. Called from the record path, which is
+  // what attributes microtask jobs: they get no BeforeCallEntered, so the
+  // first record of a checkpoint opens the task and the rest of the
+  // checkpoint reuses it. Deliberately does NOT set in_js_, so the next real
+  // JS entry still mints a fresh id rather than inheriting this one.
+  void EnsureTaskOpen();
+
+  void PutU8(uint8_t v);
+  void PutVarint(uint64_t v);
+  void PutBytes(base::span<const uint8_t> data);
+  void MaybeFlush();
+  Vector<uint8_t>& Sink() {
+    return building_record_ ? record_buf_ : buffer_;
+  }
+
+  base::File file_;
+  Vector<uint8_t> buffer_;
+  // Records are assembled here, then appended to buffer_ as a unit. Interning
+  // emits its own record and can be triggered *mid-value* when EncodeValue
+  // meets a new interface name; writing both to one buffer spliced the intern
+  // record into the middle of the binding record and corrupted the stream.
+  Vector<uint8_t> record_buf_;
+  // Selects where Put* writes. A bool rather than a pointer member because
+  // Chromium's raw_ptr plugin rejects raw pointer fields.
+  bool building_record_ = false;
+  HashMap<const char*, uint32_t> interned_;
+  // ScriptWrappable* -> run-local object id. Addresses only; never
+  // dereferenced. An address freed and reused by Oilpan would alias two
+  // objects, which the differ would read as identity -- acceptable for now and
+  // far better than mutating page objects to carry an id (see ObjectIdFor).
+  HashMap<const void*, uint64_t> wrappable_ids_;
+  uint32_t next_intern_id_ = 0;
+  uint64_t next_object_id_ = 1;
+  uint64_t seq_ = 0;
+  // Task id state driven by the V8 callbacks above.
+  bool isolate_hooked_ = false;
+  bool in_js_ = false;
+  uint64_t current_task_id_ = 0;
+  uint64_t next_task_id_ = 0;
+  // Script that was on top of the stack when the current task opened. Paired
+  // with each record's own top script this gives the differ a three-way split:
+  // guest task + guest top (the guest doing its own work), guest task + shim
+  // top (the shim acting on the guest's behalf -- a trap), shim task + shim
+  // top (the shim's own work, e.g. its startup platform snapshot).
+  uint32_t current_entry_script_ = 0;
+  // V8 script ids already emitted as kScript. Keyed on the id, not a pointer:
+  // unlike interned literals these are not compile-time constants.
+  //
+  // WTF hash tables reserve 0 as the empty-bucket sentinel for integer keys,
+  // so 0 must never be inserted. CurrentScriptId returns early for id <= 0,
+  // which is also the "no JS on the stack" case, so it never reaches here.
+  HashSet<uint32_t> known_scripts_;
+  uint64_t records_written_ = 0;
+};
+
+// sbxdiff: the TimeTicks virtual time started from, published by Page's
+// constructor when --sbxdiff-initial-time enables it.
+//
+// performance.timeOrigin is normally the document loader's reference ticks,
+// which under virtual time land a variable ~15-17 ms after the clock starts --
+// measured as ~1.7 ms of jitter in timeOrigin and performance.now() across
+// runs, while Date.now() was already exact. Pinning the origin to the instant
+// virtual time began removes the variable term.
+PLATFORM_EXPORT void SetVirtualTimeBase(base::TimeTicks base);
+
+// Policy named by --sbxdiff-virtual-time-policy, defaulting to
+// kDeterministicLoading. Shared so the two enable sites cannot drift.
+PLATFORM_EXPORT int VirtualTimePolicyFromSwitch();
+
+// Budget named by --sbxdiff-virtual-time-budget, in milliseconds.
+PLATFORM_EXPORT int64_t VirtualTimeBudgetFromSwitch();
+
+// True when --sbxdiff-virtual-time-after is set and `url` contains its value,
+// i.e. this is the realm whose setup should start virtual time.
+PLATFORM_EXPORT bool IsVirtualTimeStartRealm(const std::string& url);
+
+// True when --sbxdiff-virtual-time-after is set at all. Page's constructor
+// skips enabling when it is, leaving the job to the matching realm.
+PLATFORM_EXPORT bool VirtualTimeIsDeferred();
+
+// Latch for deferred virtual time: false until the start realm has enabled it.
+// After that every realm re-arms the budget, because under kAdvance the clock
+// only moves while budget remains and a sandbox's page load is serviced by a
+// worker that needs it to keep moving.
+PLATFORM_EXPORT bool VirtualTimeHasStarted();
+PLATFORM_EXPORT void MarkVirtualTimeStarted();
+PLATFORM_EXPORT base::TimeTicks GetVirtualTimeBase();
+
+}  // namespace blink::sbxdiff
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_TRACER_H_
