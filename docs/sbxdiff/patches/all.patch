+
+namespace content {
+class WebContents;
+}
+
+namespace sbxdiff {
+
+// sbxdiff: in-binary run driver, selected by --sbxdiff-run[=<grace_ms>].
+//
+// Replaces --dump-dom / --virtual-time-budget for traced runs. Those go through
+// the headless command handler, which navigates a *second* WebContents to
+// chrome://headless/headless_command.html and drives the target over CDP. That
+// costs two things the oracle cares about:
+//
+//   1. The handler page is a whole extra realm in every trace (34 records per
+//      run of chrome://headless/headless_command.html), which the differ then
+//      has to know to ignore.
+//   2. Attaching a DevTools session is observable from the page -- enabling
+//      the Runtime and Debugger domains changes console and stack-trace
+//      behaviour -- so a CDP-driven run is not a valid oracle for a site that
+//      looks.
+//
+// This driver attaches to the tab the normal startup path already opened, so
+// the page runs in an ordinary browser tab rather than a synthetic WebContents,
+// and quits once the page has stopped loading and a grace period has passed.
+// Virtual time does not need CDP any more: it is enabled renderer-side in
+// Page's constructor (see docs/sbxdiff/CHROMIUM-PATCHES.md 0010).
+//
+// The trace files are the output; nothing is dumped to stdout.
+bool ShouldRunSbxdiff();
+
+// Attaches a self-owned observer to `web_contents`. Must only be called when
+// ShouldRunSbxdiff() is true.
+void AttachSbxdiffRunner(content::WebContents* web_contents);
+
+}  // namespace sbxdiff
