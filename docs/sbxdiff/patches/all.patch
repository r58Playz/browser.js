+
+void SbxTracer::TraceInterceptorOutcome(uint64_t target_seq,
+                                        bool intercepted) {
+  // The inner callback is expected to have written its own record at
+  // `target_seq`. If it did not (tracer disabled mid-run, or a callback with
+  // no scope), there is nothing to annotate -- emitting a dangling reference
+  // would be worse than emitting nothing.
+  if (seq_ <= target_seq) {
+    return;
+  }
+  // No seq of its own: this is an annotation on an existing record, not an
+  // event in the guest-observable order.
+  record_buf_.Shrink(0);
+  building_record_ = true;
+  PutVarint(static_cast<uint64_t>(RecordKind::kInterceptorOutcome));
+  PutVarint(target_seq);
+  PutU8(intercepted ? 1 : 0);
+  building_record_ = false;
+  buffer_.Append(record_buf_.begin(), record_buf_.end());
+  ++records_written_;
+  MaybeFlush();
+}
