new file mode 100644
index 0000000000000..36d61ce6bc974
--- /dev/null
+++ b/chrome/browser/headless/sbxdiff_net_replay.cc
@@ -0,0 +1,145 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/headless/sbxdiff_net_replay.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sbxdiff_net_store.h"
+#include "base/strings/strcat.h"
+#include "base/byte_size.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_util.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_loader_factory.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace sbxdiff {
+
+namespace {
+
+// A URLLoader that has already delivered everything by the time it is bound.
+// The client drives completion; nothing here needs to respond.
+class ReplayLoader : public network::mojom::URLLoader {
+ public:
+  ReplayLoader() = default;
+  ReplayLoader(const ReplayLoader&) = delete;
+  ReplayLoader& operator=(const ReplayLoader&) = delete;
+  ~ReplayLoader() override = default;
+
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams,
+                      const std::optional<GURL>&) override {}
+  void SetPriority(net::RequestPriority, int32_t) override {}
+};
+
+class ReplayFactory : public network::mojom::URLLoaderFactory {
+ public:
+  static void Create(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+    // Owned by its ReceiverSet; deleted when the last client disconnects.
+    auto* factory = new ReplayFactory();
+    factory->receivers_.Add(factory, std::move(receiver));
+    factory->receivers_.set_disconnect_handler(base::BindRepeating(
+        &ReplayFactory::OnDisconnect, base::Unretained(factory)));
+  }
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+    mojo::Remote<network::mojom::URLLoaderClient> client_remote(
+        std::move(client));
+
+    base::sbxdiff::StoredResponse stored;
+    if (!base::sbxdiff::LookupResponse(request.url.spec(), &stored)) {
+      // Replay miss: fail rather than fall through to the network. Silently
+      // fetching would break hermeticity, which is the whole point.
+      client_remote->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    if (mojo::CreateDataPipe(stored.body.size() + 1, producer, consumer) !=
+        MOJO_RESULT_OK) {
+      client_remote->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_INSUFFICIENT_RESOURCES));
+      return;
+    }
+
+    auto head = network::mojom::URLResponseHead::New();
+    head->mime_type = stored.mime_type;
+    head->charset = stored.encoding;
+    head->content_length = static_cast<int64_t>(stored.body.size());
+    const std::string headers = base::StrCat(
+        {"HTTP/1.1 200 OK\r\nContent-Type: ", stored.mime_type, "\r\n\r\n"});
+    head->headers = base::MakeRefCounted<net::HttpResponseHeaders>(
+        net::HttpUtil::AssembleRawHeaders(headers));
+
+    client_remote->OnReceiveResponse(std::move(head), std::move(consumer),
+                                     std::nullopt);
+
+    // The pipe was sized to the body, so a single write suffices.
+    if (!stored.body.empty()) {
+      size_t written = 0;
+      producer->WriteData(base::as_byte_span(stored.body),
+                          MOJO_WRITE_DATA_FLAG_NONE, written);
+    }
+    producer.reset();
+
+    network::URLLoaderCompletionStatus status(net::OK);
+    status.encoded_data_length = base::ByteSize(stored.body.size());
+    status.decoded_body_length = base::ByteSize(stored.body.size());
+    client_remote->OnComplete(status);
+
+    // Keep a loader alive for the client's handle.
+    mojo::MakeSelfOwnedReceiver(std::make_unique<ReplayLoader>(),
+                                std::move(loader));  // NOLINT
+  }
+
+  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      override {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+ private:
+  ReplayFactory() = default;
+  ~ReplayFactory() override = default;
+
+  void OnDisconnect() {
+    if (receivers_.empty()) {
+      delete this;
+    }
+  }
+
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> receivers_;
+};
+
+}  // namespace
+
+void MaybeInstallReplayInterceptor(network::URLLoaderFactoryBuilder& builder) {
+  if (!base::sbxdiff::IsReplayingResponses()) {
+    return;
+  }
+  auto [receiver, unused_remote] = builder.Append();
+  // The remote is dropped deliberately: strict replay never forwards.
+  ReplayFactory::Create(std::move(receiver));
+}
+
+}  // namespace sbxdiff
