+  // sbxdiff: validate switch *syntax* here, the earliest callback, so a bad
+  // value aborts the whole run with a clear message before any child process
+  // is spawned. The renderer-side CHECK remains as a backstop, but on its own
+  // it is the wrong kind of loud: it kills the renderer and leaves a headless
+  // run hanging, which is the silent-failure shape RULES.md #13 exists to
+  // prevent. Returning a value from this function exits with that code.
+  {
+    const base::CommandLine* sbx_cmd = base::CommandLine::ForCurrentProcess();
+    for (const char* sbx_switch : {::switches::kSbxdiffInitialTime,
+                                   ::switches::kSbxdiffTimeOffset,
+                                   ::switches::kSbxdiffVirtualTimeBudget}) {
+      if (!sbx_cmd || !sbx_cmd->HasSwitch(sbx_switch)) {
+        continue;
+      }
+      const std::string value = sbx_cmd->GetSwitchValueASCII(sbx_switch);
+      int64_t unused_ms = 0;
+      if (!base::StringToInt64(value, &unused_ms)) {
