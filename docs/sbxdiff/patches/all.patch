@@ -0,0 +1,90 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_SBXDIFF_SBXDIFF_NET_OBSERVER_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_SBXDIFF_SBXDIFF_NET_OBSERVER_H_
+
+#include <stdint.h>
+
+#include "base/containers/span_or_size.h"
+#include "base/time/time.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/heap/member.h"
+#include "third_party/blink/renderer/platform/wtf/hash_map.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink {
+
+class DocumentLoader;
+class LocalFrame;
+class Resource;
+class ResourceResponse;
+
+// sbxdiff: records response bodies for hermetic replay, via the same probes
+// DevTools uses.
+//
+// Why probes and not the ResourceFetcher hook this replaced. Capturing from
+// `Resource::ResourceBuffer()` misses exactly the resources that matter most on
+// a real site:
+//
+//   - `fetch()` and XHR are `ResourceType::kRaw` with
+//     `kDoNotBufferData` -- the body streams straight to the consumer and is
+//     never buffered on the Resource, so a recorded body came out **empty**.
+//   - the main document is loaded by DocumentLoader, not ResourceFetcher, so it
+//     was not recorded at all.
+//
+// `probe::DidReceiveData` carries the raw bytes for *every* load, which is how
+// DevTools can show a fetch() response body; `InspectorNetworkAgent` explicitly
+// buffers when the policy is `kDoNotBufferData`. The probes are plain Blink
+// observers (`InspectorTraceEvents`, `LCPScriptObserver` and others use them
+// with no DevTools session), so this needs no CDP -- which matters because a
+// DevTools session is page-observable and would invalidate the oracle.
+//
+// `NetworkResourcesData::Clear(preserved_loader_id)` is the equivalent
+// cross-navigation handling on the DevTools side; here each request's buffer is
+// keyed by identifier and flushed on DidFinishLoading, so a navigation simply
+// ends the requests belonging to the old loader.
+class CORE_EXPORT SbxdiffNetObserver
+    : public GarbageCollected<SbxdiffNetObserver> {
+ public:
+  explicit SbxdiffNetObserver(LocalFrame* local_root);
+  SbxdiffNetObserver(const SbxdiffNetObserver&) = delete;
+  SbxdiffNetObserver& operator=(const SbxdiffNetObserver&) = delete;
+
+  void Shutdown();
+
+  // Probe hooks, called by core_probes. Do not call directly.
+  void DidReceiveResourceResponse(uint64_t identifier,
+                                  DocumentLoader*,
+                                  const ResourceResponse&,
+                                  const Resource*);
+  void DidReceiveData(uint64_t identifier,
+                      DocumentLoader*,
+                      base::SpanOrSize<const char> data);
+  void DidFinishLoading(uint64_t identifier,
+                        DocumentLoader*,
+                        base::TimeTicks finish_time,
+                        int64_t encoded_data_length,
+                        int64_t decoded_body_length);
+
+  void Trace(Visitor*) const;
+
+ private:
+  struct Pending {
+    String url;
+    String mime_type;
+    String encoding;
+    Vector<char> body;
+  };
+
+  Member<LocalFrame> local_root_;
+  // Keyed by probe identifier; entries live only until DidFinishLoading.
+  HashMap<uint64_t, Pending> pending_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_SBXDIFF_SBXDIFF_NET_OBSERVER_H_
