+  pending.url = response.CurrentRequestUrl().GetString();
+  pending.mime_type = response.MimeType();
+  pending.encoding = response.TextEncodingName();
+  pending_.Set(identifier, std::move(pending));
+}
+
+void SbxdiffNetObserver::DidReceiveData(uint64_t identifier,
+                                        DocumentLoader*,
+                                        base::SpanOrSize<const char> data) {
+  if (!base::sbxdiff::IsRecordingResponses()) {
+    return;
+  }
+  auto it = pending_.find(identifier);
+  if (it == pending_.end()) {
+    return;
+  }
+  // This is the call that makes fetch()/XHR recordable: the bytes arrive here
+  // even when the Resource itself never buffers them.
+  if (auto span = data.span(); span) {
+    // WTF Vector has no AppendSpan; Append(begin, end) is the iterator form.
+    it->value.body.Append(span->begin(), span->end());
+  }
+}
+
+void SbxdiffNetObserver::DidFinishLoading(uint64_t identifier,
+                                         DocumentLoader*,
+                                         base::TimeTicks,
+                                         int64_t,
+                                         int64_t) {
+  if (!base::sbxdiff::IsRecordingResponses()) {
+    return;
+  }
+  auto it = pending_.find(identifier);
+  if (it == pending_.end()) {
+    return;
+  }
+  const Pending& pending = it->value;
+  // No headers: a Blink probe sees a parsed ResourceResponse, not the raw
+  // header block, and the store wants the bytes verbatim. That, plus opaque
+  // cross-origin bodies never arriving here at all, is why this recorder is
+  // superseded by the browser-side one and is no longer installed --
+  // see LocalFrame's MaybeCreateSbxdiffNetObserver call site.
+  base::sbxdiff::RecordResponse(pending.url.Utf8(), pending.mime_type.Utf8(),
+                                pending.encoding.Utf8(), /*raw_headers=*/"",
+                                /*request_body=*/"", pending.body.data(),
+                                pending.body.size());
+  pending_.erase(it);
+}
+
+void SbxdiffNetObserver::Trace(Visitor* visitor) const {
+  visitor->Trace(local_root_);
+}
+
+}  // namespace blink
