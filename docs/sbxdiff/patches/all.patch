+  if (*min_requested <= previous_ticks) {
+    return;
+  }
+  current_ticks_.store(*min_requested, std::memory_order_release);
+  for (const auto& entry : requested_ticks_by_client_) {
+    entry.first->ScheduleWork();
+  }
