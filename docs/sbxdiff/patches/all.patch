+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/sbxdiff_net_store.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/base_switches.h"
+#include "base/command_line.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/hash/hash.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time_override.h"
+
+namespace base::sbxdiff {
+
+namespace {
+
+const FilePath& RecordDir() {
+  static NoDestructor<FilePath> dir([] {
+    const CommandLine* cmd = CommandLine::ForCurrentProcess();
+    return cmd ? cmd->GetSwitchValuePath(::switches::kSbxdiffNetRecord)
+               : FilePath();
+  }());
+  return *dir;
+}
+
+const FilePath& ReplayDir() {
+  static NoDestructor<FilePath> dir([] {
+    const CommandLine* cmd = CommandLine::ForCurrentProcess();
+    return cmd ? cmd->GetSwitchValuePath(::switches::kSbxdiffNetReplay)
+               : FilePath();
+  }());
+  return *dir;
+}
+
+// 64 bits of filename, from two independent hashes. The URL is stored in the
+// file and verified on read, so a collision degrades to a recorded miss rather
+// than serving the wrong body.
+//
+// The URL is used whole. An earlier version stripped Cloudflare's per-attempt
+// `__cf_chl_tk`/`__cf_chl_rt_tk` parameters, on the theory that a token minted
+// during recording could never be asked for again. That was wrong twice over:
+// the token is minted by the SERVER and lives in the recorded challenge HTML,
+// so a replay of those exact bytes asks for exactly the same URL; and stripping
+// collapsed four distinct steps of the challenge -- the bare URL, the redirect
+// token, the challenge, the success token -- onto one key, which scrambled the
+// ordinals that put them back in order.
+std::string KeyFor(const std::string& url) {
+  const uint32_t a = PersistentHash(url);
+  std::string reversed(url.rbegin(), url.rend());
+  const uint32_t b = PersistentHash(reversed);
+  return NumberToString(a) + "_" + NumberToString(b);
+}
+
+// Every recording gets its own file; the suffix is what puts them back in
+// order. A URL can be requested more than once and return different bodies,
+// so one file per URL would lose all but the last.
+//
+// The clock is deliberately the REAL one: under --sbxdiff-initial-time
+// Time::Now() is virtual and may not advance at all between two writes, which
+// would make the suffix useless exactly when it is needed. The per-process
+// counter breaks ties within a microsecond; ordering across processes comes
+// from the timestamp, which matters because a challenge page and the page it
+// leads to are often in different renderers.
+std::string OrderSuffix() {
+  static std::atomic<uint32_t> seq{0};
+  const int64_t micros =
+      (subtle::TimeNowIgnoringOverride() - Time::UnixEpoch()).InMicroseconds();
+  return NumberToString(micros) + "_" +
+         NumberToString(seq.fetch_add(1, std::memory_order_relaxed));
+}
+
+constexpr char kSep = '\n';
+constexpr std::string_view kMagicV2 = "SBXD2\n";
+constexpr std::string_view kMagicV3 = "SBXD3\n";
+
+std::string Serialize(const std::string& url,
+                      const std::string& mime_type,
+                      const std::string& encoding,
+                      const std::string& raw_headers,
+                      const std::string& request_body,
+                      const char* data,
+                      size_t size) {
+  std::string out;
+  out.reserve(kMagicV3.size() + url.size() + raw_headers.size() +
+              request_body.size() + size + 64);
+  out.append(kMagicV3);
+  out.append(url).push_back(kSep);
+  out.append(mime_type).push_back(kSep);
+  out.append(encoding).push_back(kSep);
+  out.append(NumberToString(raw_headers.size())).push_back(kSep);
+  out.append(NumberToString(request_body.size())).push_back(kSep);
+  out.append(raw_headers);
+  out.append(request_body);
+  if (data && size) {
+    out.append(data, size);
+  }
+  return out;
+}
+
+// Splits a record back into its URL and its parts. Understands both the v2
+// format and the older headerless one.
+bool Deserialize(const std::string& contents,
+                 std::string* url_out,
+                 StoredResponse* out) {
+  size_t pos = 0;
+  bool v2 = false;
+  bool v3 = false;
+  if (contents.size() >= kMagicV3.size() &&
+      std::string_view(contents).substr(0, kMagicV3.size()) == kMagicV3) {
+    v2 = v3 = true;
+    pos = kMagicV3.size();
+  } else if (contents.size() >= kMagicV2.size() &&
+             std::string_view(contents).substr(0, kMagicV2.size()) == kMagicV2) {
+    v2 = true;
+    pos = kMagicV2.size();
+  }
+  auto field = [&](std::string* dest) {
+    const size_t end = contents.find(kSep, pos);
+    if (end == std::string::npos) {
+      return false;
+    }
+    dest->assign(contents, pos, end - pos);
+    pos = end + 1;
+    return true;
+  };
+  std::string url;
+  std::string mime;
+  std::string encoding;
+  if (!field(&url) || !field(&mime) || !field(&encoding)) {
+    return false;
+  }
+  std::string raw_headers;
+  std::string request_body;
+  if (v2) {
+    std::string len_str;
+    if (!field(&len_str)) {
+      return false;
+    }
+    size_t header_len = 0;
+    if (!StringToSizeT(len_str, &header_len)) {
+      return false;
+    }
+    size_t body_len = 0;
+    if (v3) {
+      std::string body_len_str;
+      if (!field(&body_len_str) || !StringToSizeT(body_len_str, &body_len)) {
+        return false;
+      }
+    }
+    if (pos + header_len + body_len > contents.size()) {
+      return false;
+    }
+    raw_headers.assign(contents, pos, header_len);
+    pos += header_len;
+    request_body.assign(contents, pos, body_len);
+    pos += body_len;
+  }
+  if (url_out) {
+    *url_out = url;
+  }
+  if (out) {
+    out->mime_type = std::move(mime);
+    out->encoding = std::move(encoding);
+    out->raw_headers = std::move(raw_headers);
+    out->request_body = std::move(request_body);
+    out->body.assign(contents, pos, std::string::npos);
+  }
+  return true;
+}
+
+}  // namespace
+
+bool IsRecordingResponses() {
+  return !RecordDir().empty();
+}
+
+bool IsReplayingResponses() {
+  return !ReplayDir().empty();
+}
+
+void RecordResponse(const std::string& url,
+                    const std::string& mime_type,
+                    const std::string& encoding,
+                    const std::string& raw_headers,
+                    const std::string& request_body,
+                    const char* data,
+                    size_t size) {
+  if (RecordDir().empty() || url.empty()) {
+    return;
+  }
+  std::string out = Serialize(url, mime_type, encoding, raw_headers,
+                              request_body, data, size);
+
+  // Drop a repeat of the response we just recorded for this URL.
+  //
+  // Browser-side interception can see one fetch more than once, and a duplicate
+  // is not harmless here: ordinals are the sequence, so a doubled entry shifts
+  // every later response. Measured on rateyourmusic, the root URL recorded five
+  // times instead of twice, which put a DIFFERENT challenge instance at ordinal
+  // 1 and made the next request's `?ray=` not match anything in the store.
+  //
+  // Only an immediately-repeated identical record is dropped, and headers are
+  // part of what is compared. A URL that really does answer differently on a
+  // second request -- a challenge and then the real page, or two redirects to
+  // different tokens -- still gets both, which is the whole point of ordinals.
+  {
+    static NoDestructor<std::map<std::string, size_t>> last_record_hash;
+    static NoDestructor<Lock> lock;
+    AutoLock guard(*lock);
+    const size_t h = std::hash<std::string>{}(out);
+    auto it = last_record_hash->find(url);
+    if (it != last_record_hash->end() && it->second == h) {
+      return;
+    }
+    (*last_record_hash)[url] = h;
+  }
+
+  // Best effort: a failed write shows up as a replay miss later, which is a
+  // recorded divergence rather than a silent wrong answer.
+  std::ignore =
+      WriteFile(RecordDir().AppendASCII(KeyFor(url) + "_" + OrderSuffix()), out);
+}
+
+namespace {
+
+// url -> every recording for it, in record order. Built once: the directory
+// has to be scanned to recover ordering from the filename suffixes, and the
+// bodies are needed on a hit anyway.
+using ReplayIndex = std::map<std::string, std::vector<StoredResponse>>;
+
+const ReplayIndex& GetReplayIndex() {
+  static NoDestructor<ReplayIndex> index([] {
+    ReplayIndex built;
+    if (ReplayDir().empty()) {
+      return built;
+    }
+    // (suffix, record) so entries sort into record order. The suffix sorts
+    // numerically, not lexicographically, hence the pair rather than a string.
+    std::map<std::string,
+             std::vector<std::pair<std::pair<int64_t, uint32_t>, StoredResponse>>>
+        staged;
+    FileEnumerator files(ReplayDir(), /*recursive=*/false,
+                         FileEnumerator::FILES);
+    for (FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+      std::string contents;
+      if (!ReadFileToString(path, &contents)) {
+        continue;
+      }
+      std::string url;
+      StoredResponse resp;
+      if (!Deserialize(contents, &url, &resp)) {
+        continue;
+      }
+      // Trailing "_<micros>_<seq>"; anything without it predates ordinals and
+      // sorts first, which keeps an old store readable.
+      int64_t micros = 0;
+      uint32_t seq = 0;
+      const std::string name = path.BaseName().MaybeAsASCII();
+      const size_t last = name.rfind('_');
+      if (last != std::string::npos && last > 0) {
+        const size_t prev = name.rfind('_', last - 1);
+        if (prev != std::string::npos) {
+          std::ignore =
+              StringToInt64(name.substr(prev + 1, last - prev - 1), &micros);
+          std::ignore = StringToUint(name.substr(last + 1), &seq);
+        }
+      }
+      staged[url].emplace_back(std::make_pair(micros, seq), std::move(resp));
+    }
+    for (auto& [url, entries] : staged) {
+      std::sort(entries.begin(), entries.end(),
+                [](const auto& a, const auto& b) { return a.first < b.first; });
+      std::vector<StoredResponse> ordered;
+      ordered.reserve(entries.size());
+      for (auto& entry : entries) {
+        ordered.push_back(std::move(entry.second));
+      }
+      built[url] = std::move(ordered);
+    }
+    return built;
+  }());
+  return *index;
+}
+
+}  // namespace
+
+bool LookupResponse(const std::string& url,
+                    size_t ordinal,
+                    StoredResponse* out) {
+  if (ReplayDir().empty()) {
+    return false;
+  }
+  const ReplayIndex& index = GetReplayIndex();
+  auto it = index.find(url);
+  if (it == index.end() || it->second.empty()) {
+    return false;
+  }
+  // Past the end reuses the last: a resource fetched more times than it was
+  // recorded is normal, and the oracle never saw more than it recorded.
+  *out = it->second[std::min(ordinal, it->second.size() - 1)];
+  return true;
+}
+
+bool LookupNextResponse(const std::string& url,
+                        StoredResponse* out,
+                        size_t* ordinal_out) {
+  size_t ordinal = 0;
+  {
+    static NoDestructor<std::map<std::string, size_t>> counts;
+    static NoDestructor<Lock> lock;
+    AutoLock guard(*lock);
+    ordinal = (*counts)[url]++;
+  }
+  if (ordinal_out) {
+    *ordinal_out = ordinal;
+  }
+  return LookupResponse(url, ordinal, out);
+}
+
+}  // namespace base::sbxdiff
