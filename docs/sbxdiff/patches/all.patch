+    //
+    // EnableVirtualTime() early-returns if virtual time is already on, so a
+    // later CDP call still applies its own policy and budget. base::Time() is
+    // passed deliberately: the null-time fallback in
+    // ThreadSchedulerBase::EnableVirtualTime reads --sbxdiff-initial-time,
+    // keeping that switch the single source of truth.
+    //
+    // Main-thread page schedulers only. A worker must not become a second
+    // virtual-time client: TryAdvancingTime takes the min across clients, so a
+    // second registrant can pin the clock forever (RULES.md #12).
+    const base::CommandLine* sbx_cmd = base::CommandLine::ForCurrentProcess();
+    // --sbxdiff-virtual-time-after defers this to the realm that matches, so
+    // harness/service-worker setup runs on the real clock. See
+    // local_window_proxy.cc.
+    if (sbx_cmd && sbx_cmd->HasSwitch(::switches::kSbxdiffInitialTime) &&
+        !sbxdiff::VirtualTimeIsDeferred()) {
+      // Publish the instant virtual time began, so performance.timeOrigin can
+      // be pinned to it instead of to a variable point during load.
+      sbxdiff::SetVirtualTimeBase(
+          virtual_time_controller->EnableVirtualTime(base::Time()));
+      // kDeterministicLoading is the default because it is what makes a
+      // plain page load reproducible. It cannot be used for a
+      // service-worker-backed sandbox: it pauses virtual time while a load is
+      // outstanding, and that load is served by a worker whose transport needs
+      // timers to progress, so neither side ever moves. --sbxdiff-virtual-
+      // time-policy=advance keeps the clock moving under the budget fence.
+      const int policy_id = sbxdiff::VirtualTimePolicyFromSwitch();
+      auto policy =
+          policy_id == 0 ? VirtualTimeController::VirtualTimePolicy::kAdvance
+          : policy_id == 1
+              ? VirtualTimeController::VirtualTimePolicy::kPause
+              : VirtualTimeController::VirtualTimePolicy::kDeterministicLoading;
+      virtual_time_controller->SetVirtualTimePolicy(policy);
+      const int64_t budget_ms = sbxdiff::VirtualTimeBudgetFromSwitch();
+      // DoNothing: the budget is a fence, and the controller documents that the
+      // policy is unaffected when it expires, so there is nothing to undo and
+      // no Oilpan lifetime to manage.
+      virtual_time_controller->GrantVirtualTimeBudget(
+          base::Milliseconds(budget_ms), base::DoNothing());
+    }
   }
   UpdateColorProviders(color_provider_colors &&
                                !color_provider_colors->IsEmpty()
