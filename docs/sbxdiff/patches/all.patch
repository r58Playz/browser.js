+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_SBXDIFF_NET_STORE_H_
+#define BASE_SBXDIFF_NET_STORE_H_
+
+#include <stddef.h>
+
+#include <string>
+
+#include "base/base_export.h"
+
+namespace base::sbxdiff {
+
+// sbxdiff: on-disk response store for hermetic network replay.
+//
+// Lives in //base because both ends need it and they are in different
+// processes: recording happens in the browser (a URLLoaderFactory interceptor,
+// the only layer that sees opaque cross-origin bodies) and so does replay.
+//
+// A file holds a v2 record:
+//
+//   "SBXD3\n" url "\n" mime "\n" encoding "\n" <header_bytes> "\n"
+//   <request_body_bytes> "\n" <raw_headers> <request_body> <body>
+//
+// `raw_headers` is net::HttpResponseHeaders::raw_headers() verbatim -- a NUL
+// separated status line and field list -- hence the explicit length, and hence
+// it cannot be a newline-delimited field, and the same for the request body.
+// A v2 file (no request body) and a headerless v1 file both still read.
+//
+// Headers are stored because the response a page sees is not just its bytes.
+// Measured on rateyourmusic: Cloudflare answers the first navigation with
+// `Critical-CH`, Chromium restarts the navigation to resend client hints, and
+// the SECOND fetch is the challenge that actually runs -- the first is thrown
+// away. A replay that serves bodies under a synthetic `200 OK` never restarts,
+// so it hands the page the abandoned challenge, whose orchestrate/fo endpoints
+// are not in the store at all. The same applies to `Location`: see
+// RecordResponse.
+//
+// The URL is stored in the file and verified on read, so a filename-hash
+// collision degrades to a recorded replay miss -- a divergence -- rather than
+// silently serving the wrong body.
+struct BASE_EXPORT StoredResponse {
+  std::string mime_type;
+  std::string encoding;
+  std::string raw_headers;
+  // The request body that produced this response, when there was one. A store
+  // answers by URL and ordinal and cannot grade a request, so an anti-bot
+  // endpoint hands back the recorded "you passed" whatever was posted to it.
+  // Keeping what the recording actually sent is what lets a replay CHECK that
+  // it is being handed a verdict on the same answer, rather than assume it.
+  std::string request_body;
+  std::string body;
+};
+
+BASE_EXPORT bool IsRecordingResponses();
+BASE_EXPORT bool IsReplayingResponses();
+
+// Appends one response. A redirect is a response: it is recorded with its
+// headers and an empty body, and the chain continues under the new URL.
+//
+// Recording only the final body of a redirect chain loses the URL the page
+// actually ends up at, and that URL is content. Cloudflare bounces
+// `https://site/` to `https://site/?__cf_chl_rt_tk=<token>`; the challenge
+// script reads the token out of `location`. Flatten the chain and the script
+// runs at a URL that has no token.
+BASE_EXPORT void RecordResponse(const std::string& url,
+                                const std::string& mime_type,
+                                const std::string& encoding,
+                                const std::string& raw_headers,
+                                const std::string& request_body,
+                                const char* data,
+                                size_t size);
+
+// The `ordinal`-th recorded response for `url`, in the order they were
+// recorded. False on a miss; the caller must treat that as a divergence
+// (RULES.md #14).
+//
+// The ordinal matters because a URL can legitimately return different bodies on
+// successive requests, and collapsing them silently changes what a replay does.
+// rateyourmusic serves a Cloudflare challenge and then the real page at the SAME
+// url: with a URL-only key the second overwrote the first, so replay jumped
+// straight to the real page and the challenge never happened. That is a
+// different user journey from the one that was recorded, and a sandbox that
+// cannot survive the challenge would have looked fine.
+//
+// An ordinal beyond the recorded count returns the LAST recording rather than
+// missing: a resource fetched twice with identical bytes is normal, and the
+// oracle only ever saw as many distinct responses as it recorded.
+BASE_EXPORT bool LookupResponse(const std::string& url,
+                                size_t ordinal,
+                                StoredResponse* out);
+
+// Same, with the ordinal drawn from a process-global per-URL counter.
+//
+// Global rather than per-factory on purpose. WillCreateURLLoaderFactory runs
+// once per factory, and a navigation that restarts (Critical-CH) gets a fresh
+// factory; a per-factory counter restarts at 0 and serves the same recording
+// twice, which is exactly the case ordinals exist to distinguish.
+BASE_EXPORT bool LookupNextResponse(const std::string& url,
+                                    StoredResponse* out,
+                                    size_t* ordinal_out);
+
+}  // namespace base::sbxdiff
+
+#endif  // BASE_SBXDIFF_NET_STORE_H_
