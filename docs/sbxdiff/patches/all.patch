+                   << " must be an integer number of milliseconds, got: "
+                   << value;
+        return CHROME_RESULT_CODE_INVALID_CMDLINE_URL;
+      }
+    }
+
+    // sbxdiff: shift the wall clock's ORIGIN without making it virtual.
+    //
+    // A sandbox cannot have virtual time (RULES.md #59), so it ran on the real
+    // wall clock while the oracle ran from a pinned origin. That is guest
+    // readable, and not only as a fingerprint: Cloudflare's JS detections take
+    // the challenge's issue time out of `__CF$cv$params.t` and compare it
+    // against `Date.now()`, so a recorded challenge replayed hours later looks
+    // stale and the script stops without an error.
+    //
+    // The delta is computed once, here, before any thread is reading the
+    // clock, and then `Time::Now()` runs at real speed from the new origin.
+    // `TimeNowIgnoringOverride` on both sides of the arithmetic so this
+    // composes with, rather than fights, any other override.
+    if (sbx_cmd && sbx_cmd->HasSwitch(::switches::kSbxdiffTimeOffset)) {
+      int64_t origin_ms = 0;
+      if (base::StringToInt64(
+              sbx_cmd->GetSwitchValueASCII(::switches::kSbxdiffTimeOffset),
+              &origin_ms)) {
+        static base::TimeDelta g_sbxdiff_time_delta =
+            (base::Time::UnixEpoch() + base::Milliseconds(origin_ms)) -
+            base::subtle::TimeNowIgnoringOverride();
